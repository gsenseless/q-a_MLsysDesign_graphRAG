# Mistral AI API Key
MISTRAL_API_KEY=your_mistral_api_key_here

# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# Embedding Model
EMBEDDING_MODEL_NAME=multi-qa-distilbert-cos-v1

MAX_TOKENS_PER_MINUTE=20000
RATE_LIMIT_DELAY=10 # Seconds between requests to avoid burst limits
TOKEN_ESTIMATE_MULTIPLIER=1.5 # 50% buffer on token estimates
RATE_LIMIT_RETRIES=5 # Number of retries
RATE_LIMIT_BASE_DELAY=15 # Base delay for exponential backoff on retry
